# NyayaPath Environment Configuration
# Copy this file to .env and fill in the values

# Tavily API Key (free tier — https://tavily.com)
TAVILY_API_KEY=tvly-your-key-here

# Ollama Configuration (defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_FALLBACK_MODEL=qwen2.5:14b

# LangSmith Tracing Configuration (Optional — https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=nyayapath

